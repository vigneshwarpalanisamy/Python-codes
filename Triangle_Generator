import random

def triangle_generator(p1,p2,p3):
    while True:
        alpha=random.random()
        beta=(1-alpha)*random.random()
        gamma=1-alpha-beta

        x=alpha*p1[0]+ beta*p2[0]+ gamma*p3[0]
        y=alpha*p1[1]+ beta*p2[1]+ gamma*p3[1]
        z=alpha*p1[2]+ beta*p2[2]+ gamma*p3[2]
        

        yield (x,y,z)




with open("triangle.csv", "w+") as f:
    a=triangle_generator((0,0,0),(1,0,0),(0,1,0))
    for i in range(10000):
        x,y,z=next(a)
        f.write(f"{x},{y},{z}\n")

