import random

def triangle_generator(p1,p2,p3):
    while True:
        alpha=random.random()
        beta=(1-alpha)*random.random()
        gamma=1-alpha-beta

        x=alpha*p1[0]+ beta*p2[0]+ gamma*p3[0]
        y=alpha*p1[1]+ beta*p2[1]+ gamma*p3[1]
        z=alpha*p1[2]+ beta*p2[2]+ gamma*p3[2]
        

        yield (x,y,z)

def triArea(a,b,c):
    x1,y1,z1=a
    x2,y2,z2=b
    x3,y3,z3=c

    area=abs(0.5*(x1*(y2-y3)+x2*(y3-y1)+x3*(y1-y2)))

    return area


def quad(p1,p2,p3,p4):

    T1=triArea(p1,p3,p4)
    T2=triArea(p1,p2,p3)

    sum1= triArea(p2,p1,p3)+triArea(p2,p3,p4)+triArea(p2,p1,p4)
    sum2= triArea(p2,p1,p4)+triArea(p2,p3,p4)+triArea(p1,p3,p4)

    
    #triangle set 1
    tri1=triangle_generator(p1,p2,p3)
    tri2=triangle_generator(p3,p4,p1)

    #triangle set 2
    tri3=triangle_generator(p1,p2,p4)
    tri4=triangle_generator(p3,p4,p2)

    #Condition to check whether one of the coordinate is inside other three coordinates
    if T1 == sum1 or T2 ==sum2:
        while True:
            yield next(tri3)
            yield next(tri4)
    else:
        while True:
            yield next(tri1)
            yield next(tri2)


with open("quad.csv", "w+") as f:
    a=quad((1,1,0),(0,-2,0),(0,0,0),(-2,0,0))
    for i in range(10000):
        x,y,z=next(a)
        f.write(f"{x},{y},{z}\n")
